{
  "name": "fnos-media-acquisition-center",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "build": "node scripts/build.mjs",
    "test:go": "go test -race ./internal/... ./module/...",
    "vet:go": "go vet ./internal/... ./module/...",
